          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝 Bark App，或依 Bark 專案文件自架伺服器。"
          }
        }
      }
    },
    "在 Bark 中生成设备密钥。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate a device key in Bark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
