          "stringUnit": {
            "state": "translated",
            "value": "在 Bark 中產生裝置金鑰。"
          }
        }
      }
    },
    "填写服务器地址与密钥，保存并启用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in the server address and key, then save and enable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写服务器地址与密钥，保存并启用。"
          }
        },
        "zh-Hant": {
