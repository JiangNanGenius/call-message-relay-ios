            "value": "設定步驟"
          }
        }
      }
    },
    "安装 Bark App，或按 Bark 项目文档自建服务器。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the Bark app, or self-host a server following the Bark project docs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
