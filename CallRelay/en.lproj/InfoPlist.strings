<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to scan the pairing QR code shown on the gateway; you can also paste the pairing content instead.</string>
	<key>NSContactsUsageDescription</key>
	<string>Used to pick numbers from contacts for dialing or texting, show contact names in recents and messages, and optionally trust your contacts as senders. The app never uploads or backs up your contacts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used during calls to send your voice to the other party through the gateway.</string>
</dict>
</plist>
