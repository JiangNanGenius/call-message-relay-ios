          "stringUnit": {
            "state": "translated",
            "value": "測試通知已傳送，請查看 Bark。"
          }
        }
      }
    },
    "网关只通知正在响铃的来电，并做去重与过期保护。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway only notifies ringing incoming calls, with deduplication and stale protection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关只通知正在响铃的来电，并做去重与过期保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閘道只通知正在響鈴的來電，並做去重與過期保護。"
          }
        }
      }
    },
    "网关未允许局域网 Bark 服务器（需要运维开启 bark.allow_private）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway does not allow LAN Bark servers (operator must turn on bark.allow_private)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关未允许局域网 Bark 服务器（需要运维开启 bark.allow_private）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閘道未允許區域網路 Bark 伺服器（需要維運開啟 bark.allow_private）。"
          }
        }
      }
    },
    "网关未启用可选的 Bark 通知桥（需要运维开启 bark.enabled）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway has not enabled the optional Bark bridge (operator must turn on bark.enabled)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关未启用可选的 Bark 通知桥（需要运维开启 bark.enabled）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閘道未啟用可選的 Bark 通知橋（需要維運開啟 bark.enabled）。"
          }
        }
      }
    },
    "设备密钥只保存在网关，不写入通知或本地存储。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device key is stored only on the gateway; it is never written to a notification or local storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备密钥只保存在网关，不写入通知或本地存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置金鑰只儲存在閘道，不寫入通知或本機儲存。"
          }
        }
      }
    },
    "设备密钥只能是可见 ASCII 字符，不能包含空格或换行。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device key must be visible ASCII characters with no spaces or line breaks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备密钥只能是可见 ASCII 字符，不能包含空格或换行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置金鑰只能是可見 ASCII 字元，不能包含空格或換行。"
          }
        }
      }
    },
    "设备密钥过长。": {
      "extractionState": "manual",
