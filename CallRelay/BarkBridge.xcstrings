{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "Apple 官方通知自动化说明": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's notification automation guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 官方通知自动化说明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 官方通知自動化說明"
          }
        }
      }
    },
    "Bark 服务器": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark 服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark 伺服器"
          }
        }
      }
    },
    "Bark 设备密钥": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark device key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark 设备密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark 裝置金鑰"
          }
        }
      }
    },
    "HTTP 只允许连接局域网或本机地址。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP is only allowed to a LAN or local address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 只允许连接局域网或本机地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 只允許連線區域網路或本機位址。"
          }
        }
      }
    },
    "iPhone 通知自动化（iOS 27）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone notification automation (iOS 27)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 通知自动化（iOS 27）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 通知自動化（iOS 27）"
          }
        }
      }
    },
    "下次保存时移除已保存的密钥": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the saved key on next save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次保存时移除已保存的密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次儲存時移除已儲存的金鑰"
          }
        }
      }
    },
    "保存中…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存中…"
          }
        }
      }
    },
    "保存失败，请稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save failed. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗，請稍後重試。"
          }
        }
      }
    },
    "发送测试通知": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send test notification"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送测试通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送測試通知"
          }
        }
      }
    },
    "发送测试通知，确认手机能收到。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a test notification to confirm your phone receives it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送测试通知，确认手机能收到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送測試通知，確認手機能收到。"
          }
        }
      }
    },
    "可选通知桥": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional notification bridge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选通知桥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選通知橋"
          }
        }
      }
    },
    "启用 Bark 来电通知（可选）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Bark call notifications (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Bark 来电通知（可选）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 Bark 來電通知（可選）"
          }
        }
      }
    },
    "启用 Bark 通知需要填写服务器地址。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a server address to enable Bark notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Bark 通知需要填写服务器地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 Bark 通知需要填寫伺服器位址。"
          }
        }
      }
    },
    "启用 Bark 通知需要填写设备密钥。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a device key to enable Bark notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Bark 通知需要填写设备密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 Bark 通知需要填寫裝置金鑰。"
          }
        }
      }
    },
    "在 Bark 中生成设备密钥。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate a device key in Bark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Bark 中生成设备密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Bark 中產生裝置金鑰。"
          }
        }
      }
    },
    "在“快捷指令 → 自动化”中新建“收到通知”自动化：筛选 Bark 通知（可按 App、标题、正文过滤，例如标题包含 CallRelay 或正文包含来电），然后运行“检查来电”。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Shortcuts → Automation, create a “When I receive a notification” automation: filter Bark notifications (by app, title or body, e.g. title contains CallRelay or body contains incoming call), then run “Check incoming call”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“快捷指令 → 自动化”中新建“收到通知”自动化：筛选 Bark 通知（可按 App、标题、正文过滤，例如标题包含 CallRelay 或正文包含来电），然后运行“检查来电”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「捷徑 → 自動化」中新增「收到通知」自動化：篩選 Bark 通知（可依 App、標題、內文過濾，例如標題包含 CallRelay 或內文包含來電），然後執行「檢查來電」。"
          }
        }
      }
    },
    "填写服务器地址与密钥，保存并启用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in the server address and key, then save and enable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写服务器地址与密钥，保存并启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填寫伺服器位址與金鑰，儲存並啟用。"
          }
        }
      }
    },
    "安全说明": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全说明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全說明"
          }
        }
      }
    },
    "安装 Bark App，或按 Bark 项目文档自建服务器。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the Bark app, or self-host a server following the Bark project docs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Bark App，或按 Bark 项目文档自建服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝 Bark App，或依 Bark 專案文件自架伺服器。"
          }
        }
      }
    },
    "尚未配对网关，无法检查来电。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gateway is paired, so incoming calls cannot be checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配对网关，无法检查来电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配對閘道，無法檢查來電。"
          }
        }
      }
    },
    "已保存 %@，留空保持不变": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saved; leave blank to keep it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 %@，留空保持不变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存 %@，留空保持不變"
          }
        }
      }
    },
    "已保存并启用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved and enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存并启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存並啟用。"
          }
        }
      }
    },
    "已保存（当前关闭）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved (currently off)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存（当前关闭）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存（目前關閉）。"
          }
        }
      }
    },
    "已发现正在响铃的来电，并显示在系统来电界面；请手动接听。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ringing incoming call was found and shown in the system call UI; answer it manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发现正在响铃的来电，并显示在系统来电界面；请手动接听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已發現正在響鈴的來電，並顯示在系統來電介面；請手動接聽。"
          }
        }
      }
    },
    "当前没有正在响铃的来电。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no ringing incoming call right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有正在响铃的来电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有正在響鈴的來電。"
          }
        }
      }
    },
    "我的 Bark 服务器在局域网或使用 HTTP": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Bark server is on the LAN or uses HTTP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的 Bark 服务器在局域网或使用 HTTP"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的 Bark 伺服器在區域網路或使用 HTTP"
          }
        }
      }
    },
    "无法读取网关设置，请稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load gateway settings. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取网关设置，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取閘道設定，請稍後重試。"
          }
        }
      }
    },
    "无法连接网关，请检查网络后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the gateway. Check your network and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接网关，请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線閘道，請檢查網路後重試。"
          }
        }
      }
    },
    "旧版 iOS 与锁屏状态下的自动执行尚未验证；未设置自动化时，点按 Bark 通知会打开 App 并用本机配对检查是否有正在响铃的来电（手动回退路径）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic execution on older iOS versions and while locked has not been verified. Without an automation, tapping the Bark notification opens the app and checks for ringing calls using this phone's pairing (manual fallback)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版 iOS 与锁屏状态下的自动执行尚未验证；未设置自动化时，点按 Bark 通知会打开 App 并用本机配对检查是否有正在响铃的来电（手动回退路径）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版 iOS 與鎖屏狀態下的自動執行尚未驗證；未設定自動化時，點按 Bark 通知會開啟 App 並用本機配對檢查是否有正在響鈴的來電（手動回退路徑）。"
          }
        }
      }
    },
    "服务器地址不是有效网址。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address is not a valid URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址不是有效网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器位址不是有效網址。"
          }
        }
      }
    },
    "服务器地址不能包含查询参数或片段。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address must not contain query parameters or a fragment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址不能包含查询参数或片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器位址不能包含查詢參數或片段。"
          }
        }
      }
    },
    "服务器地址不能包含账号或密码。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address must not contain a username or password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址不能包含账号或密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器位址不能包含帳號或密碼。"
          }
        }
      }
    },
    "服务器地址使用 HTTP 时必须开启“局域网自建服务器”。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP server addresses require “LAN self-hosted server” to be enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址使用 HTTP 时必须开启“局域网自建服务器”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器位址使用 HTTP 時必須開啟「區域網路自架伺服器」。"
          }
        }
      }
    },
    "服务器地址填写 Bark 自建服务的根地址，例如 http://192.168.1.10:8080；使用官方服务器可填 https://api.day.app。设备密钥只会上传给已配对网关。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the root address of your self-hosted Bark server, e.g. http://192.168.1.10:8080; for the official server use https://api.day.app. The device key is only sent to your paired gateway."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址填写 Bark 自建服务的根地址，例如 http://192.168.1.10:8080；使用官方服务器可填 https://api.day.app。设备密钥只会上传给已配对网关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器位址請填寫 Bark 自架服務的根位址，例如 http://192.168.1.10:8080；使用官方伺服器可填 https://api.day.app。裝置金鑰只會上傳到已配對閘道。"
          }
        }
      }
    },
    "服务器地址必须以 http:// 或 https:// 开头。": {
