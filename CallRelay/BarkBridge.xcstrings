    },
    "测试通知已发送，请查看 Bark。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test notification sent; check Bark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试通知已发送，请查看 Bark。"
          }
        },
