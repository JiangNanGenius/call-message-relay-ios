      }
    },
    "浏览器订阅密钥只保存在网关，App 与通知中都不包含订阅密钥。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription keys stay on the gateway — never in this app or in notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器订阅密钥只保存在网关，App 与通知中都不包含订阅密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱密鑰只保存在網關，App 與通知都不包含。"
          }
        }
      }
    },
    "通知链接使用一次性、短时有效的令牌并放在网址片段中，服务器与代理日志不会记录。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification links use a one-time token that server logs never record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知链接使用一次性、短时有效的令牌并放在网址片段中，服务器与代理日志不会记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知連結使用一次性令牌，伺服器日誌不會記錄。"
          }
        }
      }
    },
    "解除配对或删除设备会同时移除浏览器订阅与网页会话。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
