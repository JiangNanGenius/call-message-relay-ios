    "网页推送由你的网关自托管服务，不经过任何第三方通知服务。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web push is served by your own CallRelay gateway."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页推送由你的网关自托管服务，不经过任何第三方通知服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁推送由你的 CallRelay 網關提供。"
          }
