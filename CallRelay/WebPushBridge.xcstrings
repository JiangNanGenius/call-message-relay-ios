{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "仅系统推送（App）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System push (app) only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅系统推送（App）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅系統推送（App）"
          }
        }
      }
    },
    "系统推送 + 网页推送": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System push + web push"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统推送 + 网页推送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統推送 + 網頁推送"
          }
        }
      }
    },
    "仅网页推送": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web push only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅网页推送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅網頁推送"
          }
        }
      }
    },
    "只通过 App 的系统推送响铃；网页不接收来电通知。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings only through the app's system push; the browser receives nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只通过 App 的系统推送响铃；网页不接收来电通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只透過 App 的系統推送響鈴；網頁不接收來電通知。"
          }
        }
      }
    },
    "App 与已绑定的浏览器都会收到来电通知（适合 App 后台不响铃时兜底）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the app and the bound browser notify — a fallback when the app doesn't ring in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 与已绑定的浏览器都会收到来电通知（适合 App 后台不响铃时兜底）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 與已綁定的瀏覽器都會收到來電通知（適合 App 後台不響鈴時兜底）。"
          }
        }
      }
    },
    "只通过已绑定的浏览器接收来电通知，App 不再收到系统来电推送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the bound browser notifies; the app no longer receives system call pushes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只通过已绑定的浏览器接收来电通知，App 不再收到系统来电推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只透過已綁定的瀏覽器接收來電通知，App 不再收到系統來電推送。"
          }
        }
      }
    },
    "绑定码是 9 位字符。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind code is 9 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定码是 9 位字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定碼是 9 位字元。"
          }
        }
      }
    },
    "绑定码只能包含数字和大写字母（不含 0、1、I、L、O）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind code contains only digits and uppercase letters (no 0, 1, I, L or O)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定码只能包含数字和大写字母（不含 0、1、I、L、O）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定碼只能包含數字和大寫字母（不含 0、1、I、L、O）。"
          }
        }
      }
    },
    "绑定链接过长。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind link is too long."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接过长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結過長。"
          }
        }
      }
    },
    "绑定链接不是有效网址。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind link is not a valid URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接不是有效网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結不是有效網址。"
          }
        }
      }
    },
    "绑定链接必须使用 https。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind link must use https."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接必须使用 https。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結必須使用 https。"
          }
        }
      }
    },
    "绑定链接不能包含账号或密码。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind link must not contain a username or password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接不能包含账号或密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結不能包含帳號或密碼。"
          }
        }
      }
    },
    "绑定链接不能把绑定码放在网址参数里。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind code must not travel in the URL query string."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接不能把绑定码放在网址参数里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結不能把綁定碼放在網址參數裡。"
          }
        }
      }
    },
    "绑定链接缺少主机名。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind link has no host name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接缺少主机名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結缺少主機名。"
          }
        }
      }
    },
    "绑定链接缺少绑定码片段。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind link has no bind-code fragment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接缺少绑定码片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結缺少綁定碼片段。"
          }
        }
      }
    },
    "绑定链接中的绑定码不一致。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bind code in the link does not match."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接中的绑定码不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結中的綁定碼不一致。"
          }
        }
      }
    },
    "重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試"
          }
        }
      }
    },
    "正在读取网关设置…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading gateway settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取网关设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取網關設定…"
          }
        }
      }
    },
    "网关未启用网页推送（需要运维开启 webpush.enabled）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This gateway has web push disabled (the operator must enable webpush.enabled)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关未启用网页推送（需要运维开启 webpush.enabled）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網關未啟用網頁推送（需要運維開啟 webpush.enabled）。"
          }
        }
      }
    },
    "已绑定浏览器": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bound browsers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已绑定浏览器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已綁定瀏覽器"
          }
        }
      }
    },
    "检查中…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查中…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查中…"
          }
        }
      }
    },
    "检查来电": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check incoming calls"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查来电"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查來電"
          }
        }
      }
    },
    "网页推送": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Push"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页推送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁通知"
          }
        }
      }
    },
    "绑定浏览器": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind a browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定浏览器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定瀏覽器"
          }
        }
      }
    },
    "生成中…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generating…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成中…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成中…"
          }
        }
      }
    },
    "生成绑定码": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate bind code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成绑定码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成綁定碼"
          }
        }
      }
    },
    "绑定链接二维码": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind link QR code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定链接二维码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定連結二維碼"
          }
        }
      }
    },
    "复制绑定链接": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy bind link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制绑定链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製綁定連結"
          }
        }
      }
    },
    "已复制绑定链接。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind link copied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制绑定链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製綁定連結。"
          }
        }
      }
    },
    "绑定码约 10 分钟内有效，仅可使用一次；过期或使用后请重新生成。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is valid for about 10 minutes and works once; regenerate it after use or expiry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定码约 10 分钟内有效，仅可使用一次；过期或使用后请重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定碼約 10 分鐘內有效，僅可使用一次；過期或使用後請重新生成。"
          }
        }
      }
    },
    "在 iPhone/iPad 上先把网关网页“添加到主屏幕”（iOS 16.4+），打开该网页应用后输入上方绑定码；绑定码与链接只在此设备屏幕上显示，不会上传到其他服务。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone/iPad, add this page to your Home Screen first (iOS 16.4+), open it from there, then enter the code above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone/iPad 上先把网关网页“添加到主屏幕”（iOS 16.4+），打开该网页应用后输入上方绑定码；绑定码与链接只在此设备屏幕上显示，不会上传到其他服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone/iPad 上先把本頁「加入主畫面」（iOS 16.4+），從主畫面打開後輸入上方綁定碼。"
          }
        }
      }
    },
    "设置步骤": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup steps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置步骤"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定步驟"
          }
        }
      }
    },
    "选择上方通知方式（默认仅系统推送；需要网页兜底时选“系统 + 网页”）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a notify mode above (default: system push only)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择上方通知方式（默认仅系统推送；需要网页兜底时选“系统 + 网页”）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇上方通知方式（預設僅系統推送）。"
          }
        }
      }
    },
    "点“生成绑定码”，在已添加到主屏幕的网关网页中输入绑定码并允许通知。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Generate bind code”, enter it in this web app on your Home Screen, then allow notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点“生成绑定码”，在已添加到主屏幕的网关网页中输入绑定码并允许通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點「生成綁定碼」，在此網頁應用中輸入並允許通知。"
          }
        }
      }
    },
    "在该网页中发送测试通知，确认此设备能收到。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a test here to confirm this device receives it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在该网页中发送测试通知，确认此设备能收到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此發送測試，確認此裝置能收到。"
          }
        }
      }
    },
    "来电时点击通知会在网页中显示来电；点“在 CallRelay 中打开”回到本 App 的来电界面（不会自动接听）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a notification to see the call here, then “Open in CallRelay” to answer in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
